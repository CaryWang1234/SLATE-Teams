{
  "id": "code-review-flow",
  "name": "代码审查流程",
  "description": "自动读取代码变更，从质量、安全、性能、可维护性四维度审查，输出结构化报告与改进建议。",
  "nodes": [
    {
      "id": "scan",
      "name": "变更扫描",
      "role": "",
      "model": "",
      "skill": "code_scan",
      "prompt": "",
      "inputs": {
        "directory": "$input"
      },
      "output_key": "scan_result",
      "max_tokens": 0,
      "temperature": 0
    },
    {
      "id": "quality",
      "name": "质量审查",
      "role": "decider",
      "model": "",
      "skill": "",
      "prompt": "你是代码质量审查专家。请审查以下代码变更，关注：命名规范、代码结构、重复代码、错误处理、边界条件。只输出审查结果，不要寒暄。\n\n变更内容：\n{{task}}\n\n安全扫描结果：\n{{scan_result}}",
      "inputs": {
        "task": "$input",
        "scan_result": "$scan"
      },
      "output_key": "quality",
      "max_tokens": 1200,
      "temperature": 0.3
    },
    {
      "id": "security",
      "name": "安全审查",
      "role": "",
      "model": "",
      "skill": "",
      "prompt": "你是代码安全审查专家。请审查以下代码变更，关注：注入漏洞、认证绕过、敏感信息泄露、不安全的依赖、权限控制。只输出审查结果，不要寒暄。\n\n变更内容：\n{{task}}\n\n安全扫描结果：\n{{scan_result}}",
      "inputs": {
        "task": "$input",
        "scan_result": "$scan"
      },
      "output_key": "security",
      "max_tokens": 1200,
      "temperature": 0.3
    },
    {
      "id": "performance",
      "name": "性能审查",
      "role": "",
      "model": "",
      "skill": "",
      "prompt": "你是代码性能审查专家。请审查以下代码变更，关注：算法复杂度、内存泄漏、N+1查询、不必要的计算、缓存策略。只输出审查结果，不要寒暄。\n\n变更内容：\n{{task}}",
      "inputs": {
        "task": "$input"
      },
      "output_key": "performance",
      "max_tokens": 1000,
      "temperature": 0.3
    },
    {
      "id": "report",
      "name": "汇总报告",
      "role": "",
      "model": "",
      "skill": "",
      "prompt": "你是代码审查汇总人。请综合质量、安全、性能三个维度的审查结果，生成一份结构化的代码审查报告：总体评分(1-10)、各维度发现、优先修复建议、最终结论（通过/需修改/拒绝）。只输出报告本身，不要寒暄。\n\n质量审查：\n{{quality}}\n\n安全审查：\n{{security}}\n\n性能审查：\n{{performance}}",
      "inputs": {
        "quality": "$quality",
        "security": "$security",
        "performance": "$performance"
      },
      "output_key": "report",
      "max_tokens": 1500,
      "temperature": 0.3
    }
  ],
  "edges": [
    { "from": "scan", "to": "quality" },
    { "from": "scan", "to": "security" },
    { "from": "scan", "to": "performance" },
    { "from": "quality", "to": "report" },
    { "from": "security", "to": "report" },
    { "from": "performance", "to": "report" }
  ]
}
